# copiar a .env y completar (el .env NO se sube al repo)

# --- LLM (obligatorio: una key, o Ollama local) ---
# Valores de LLM_PROVIDER: openai, anthropic, gemini, ollama. La entrega se probó con openai / gpt-4o-mini:
# Phoenix calcula el costo de cada ejecución con los precios de ese modelo.
LLM_PROVIDER=openai
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
# modelos por defecto: gpt-4o-mini / claude-sonnet-4-6 / gemini-flash-latest / llama3.2
# OPENAI_MODEL=
OLLAMA_MODEL=llama3.2
OLLAMA_BASE_URL=http://localhost:11434
TEMPERATURE=0

# --- Orquestador (Pre-Entrega 6) ---
# Intervenciones máximas de especialistas por tarea (evita el "supervisor infinito")
MAX_PASOS=8
# Reparaciones por especialista antes de escalar a revisión humana
MAX_REPARACIONES=2
# Techo de pasos de LangGraph por ejecución (cada vuelta especialista -> validador -> supervisor usa 3)
RECURSION_LIMIT=40
# Búsqueda en las fichas: local (BM25 sobre data/) o pinecone (requiere requirements-pinecone.txt)
BUSQUEDA_BACKEND=local
PINECONE_API_KEY=
INDEX_NAME=volkswagen-rag-hibrido
NAMESPACE=vw-modelos-dev
DATA_DIR=data

# --- API y Redis (Pre-Entrega 7) ---
# Redis 8 (docker compose up -d): estado de los jobs, cola, checkpoints de LangGraph y reservas
REDIS_URL=redis://localhost:6379/0
# Jobs en paralelo por proceso (tareas asyncio). 5 = las 5 peticiones concurrentes de la prueba de carga
WORKERS=5
# true: la API corre los workers en su event loop. false: correrlos aparte con "python -m app.worker"
WORKER_EN_PROCESO=true
# Techo de tiempo de una ejecución del grafo: si se pasa, el job queda FAILED
TIMEOUT_JOB_S=300

# --- Observabilidad (Arize Phoenix) ---
PHOENIX_HABILITADO=true
PHOENIX_COLLECTOR_ENDPOINT=http://localhost:6006/v1/traces
PHOENIX_PROJECT_NAME=orquestador-vw
